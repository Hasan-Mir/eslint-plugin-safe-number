{
    "name": "eslint-plugin-safe-number",
    "version": "1.1.5",
    "description": "ESLint rule to prevent unsafe Number conversions",
    "author": "Hasan Mir",
    "license": "MIT",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "package.json",
        "README.md"
    ],
    "keywords": [
        "eslint",
        "plugin",
        "typescript",
        "number",
        "safe"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Hasan-Mir/eslint-plugin-safe-number.git"
    },
    "bugs": {
        "url": "https://github.com/Hasan-Mir/eslint-plugin-safe-number/issues"
    },
    "homepage": "https://github.com/Hasan-Mir/eslint-plugin-safe-number#readme",
    "scripts": {
        "build": "tsc",
        "checktype": "tsc --noEmit --skipLibCheck",
        "pretest": "node -e \"require('node:fs').rmSync('dist-tests', { recursive: true, force: true })\"",
        "test": "tsc -p tsconfig.test.json && node --test \"dist-tests/tests/**/*.test.js\"",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@typescript-eslint/utils": "^8.0.0"
    },
    "devDependencies": {
        "@types/node": "^20.19.43",
        "@typescript-eslint/parser": "^8.0.0",
        "@typescript-eslint/rule-tester": "^8.0.0",
        "eslint": "^9.0.0",
        "typescript": "^5.0.0"
    },
    "peerDependencies": {
        "eslint": "*",
        "typescript": "*"
    }
}
